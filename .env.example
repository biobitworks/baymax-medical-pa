# Server-only values. Never prefix credentials with VITE_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
# Exact public UI origin required when serving behind a production proxy.
# APP_ORIGIN=https://baymax.example.com

# Reserved for future account login and medical record uploads.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=

# Exa web search (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# If Mastra starts on another port, point the Vite proxy at its URL.
# MASTRA_API_URL=http://localhost:4112
