# Server-only credentials. Copy to .env and fill in the values you use.
# Exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Existing Baymax agent model via Neon AI Gateway
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# If Mastra starts on another port, point the Vite proxy at its URL.
# MASTRA_API_URL=http://localhost:4112

# Optional local Mastra storage override
# MASTRA_DB_URL=file:../../mastra.db
