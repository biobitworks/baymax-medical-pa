{
  "name": "baymax-medical-pa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:search": "node --experimental-strip-types --test tests/exa-search.test.ts tests/web-search-ui.test.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "agent:dev": "mastra dev",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "agent:build": "mastra build",
    "agent:start": "node --env-file=.env --env-file-if-exists=.env.local .mastra/output/index.mjs",
    "test:live": "node --import tsx scripts/smoke.ts",
    "test:fitness": "node --experimental-strip-types --test tests/fitness.test.ts",
    "test:pwa": "npm run build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "record:notifications": "node scripts/record-notifications.mjs",
    "computer:build": "docker build -t baymax-computer:local services/computer",
    "test:computer": "node --import tsx scripts/smoke-computer.ts",
    "browser:worker": "npm --prefix services/browser-worker start",
    "test:computer:api": "node --import tsx scripts/smoke-computer-api.ts",
    "shortcut:local": "node scripts/shortcut-local.mjs",
    "shortcut:build": "python3 scripts/build-apple-health-shortcut.py --sign"
  },
  "dependencies": {
    "@assistant-ui/react": "0.11.54",
    "@mastra/core": "^1.74.0",
    "@mastra/libsql": "^1.25.0",
    "@mastra/observability": "^1.18.3",
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neon/config": "^1.8.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "mastra": "^1.32.1",
    "react-test-renderer": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "nanoid": "^5.1.16"
  }
}
